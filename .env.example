# Copiá este archivo a `.env` y completá los valores.
# `.env` está en .gitignore: nunca se sube al repo. Este archivo SÍ se sube,
# por eso solo lleva nombres de variables y valores de ejemplo, nunca secretos reales.

# --- Postgres (data warehouse local: capas silver/gold) ---
# Desde tu PC usás localhost; adentro de Docker, docker-compose lo cambia por "postgres".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ventas
POSTGRES_USER=ventas
POSTGRES_PASSWORD=cambiar_por_un_password_local

# --- Object storage compatible con S3 (data lake: capa bronze) ---
# En local apunta a RustFS. En AWS se deja vacío y boto3 usa el S3 real.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=cambiar_por_un_usuario_local
S3_SECRET_KEY=cambiar_por_un_password_local_de_8_o_mas
AWS_REGION=us-east-1
# Los buckets quedan como <prefijo>-bronze, <prefijo>-silver, <prefijo>-gold.
# En AWS los nombres de bucket son únicos en el MUNDO: ahí usaremos algo como ventas-lucio-dev.
S3_BUCKET_PREFIX=ventas

# --- Logging ---
LOG_LEVEL=INFO

# --- Panel ---
# Solo para MOSTRAR horas: los datos siempre se guardan en UTC.
APP_TIMEZONE=America/Argentina/Buenos_Aires
